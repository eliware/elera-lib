# Primary SQL route. MYSQL_HOST and MYSQL_PORT are accepted aliases.
MYSQL_PRIMARY_HOST=localhost
MYSQL_PRIMARY_PORT=3306

# Optional balanced/read route. Both routes may accept writes.
# MYSQL_BALANCED_HOST=localhost
# MYSQL_BALANCED_PORT=3306

MYSQL_USER=replace-with-runtime-user
MYSQL_PASSWORD=replace-with-runtime-password
MYSQL_DATABASE=app_database

# Optional pool settings.
# MYSQL_CONNECT_TIMEOUT=10000
# MYSQL_ACQUIRE_TIMEOUT=10000
# MYSQL_CONNECTION_LIMIT=10
# MYSQL_QUEUE_LIMIT=0
# MYSQL_SSL=false
