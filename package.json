{
    "name": "@eliware/elera-lib",
    "version": "0.1.7",
    "description": "Generic MySQL and MariaDB client with resilient routing, telemetry, client-side drains, and failover",
    "keywords": [
        "eliware",
        "elera",
        "mysql",
        "mariadb",
        "sql",
        "database",
        "routing",
        "failover",
        "telemetry",
        "websocket",
        "connection-pool"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/eliware/elera-lib.git"
    },
    "homepage": "https://github.com/eliware/elera-lib#readme",
    "bugs": {
        "url": "https://github.com/eliware/elera-lib/issues"
    },
    "license": "Apache-2.0",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": "./src/index.mjs"
        }
    },
    "files": [
        "src",
        "examples",
        "README.md",
        "RELEASE_NOTES.md",
        "LICENSE",
        "THIRD-PARTY-NOTICES.md"
    ],
    "scripts": {
        "test": "eliware-test",
        "integration": "node scripts/integration.mjs",
        "lint": "eliware-test --lint",
        "check": "node --check src/index.mjs",
        "contracts": "node scripts/verify-contracts.mjs",
        "typecheck": "tsc --project tsconfig.json",
        "pack": "npm pack --dry-run",
        "audit": "npm audit --omit=dev --audit-level=moderate"
    },
    "dependencies": {
        "@eliware/common": "^2.0.0",
        "@eliware/snowflake": "^2.0.0",
        "mysql2": "^3.24.2"
    },
    "devDependencies": {
        "@eliware/test": "^2.0.0",
        "@types/node": "^26.4.0",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "typescript": "^7.0.2"
    },
    "publishConfig": {
        "access": "public"
    }
}