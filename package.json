{
    "name": "@eliware/elera-lib",
    "version": "0.3.1",
    "description": "Shared Elera routing contracts and validation",
    "keywords": [
        "eliware",
        "elera",
        "protocol",
        "contracts",
        "routing",
        "lifecycle",
        "validation",
        "routing-contracts",
        "shared-library"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/eliware/elera-lib.git"
    },
    "homepage": "https://github.com/eliware/elera-lib#readme",
    "bugs": {
        "url": "https://github.com/eliware/elera-lib/issues"
    },
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=26"
    },
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": "./src/index.mjs"
        }
    },
    "files": [
        "src",
        "contracts",
        "examples",
        "README.md",
        "RELEASE_NOTES.md",
        "LICENSE",
        "THIRD-PARTY-NOTICES.md"
    ],
    "scripts": {
        "test": "eliware-test",
        "lint": "eliware-test --lint",
        "check": "node --check src/index.mjs",
        "contracts": "node scripts/verify-contracts.mjs",
        "typecheck": "tsc --project tsconfig.json",
        "pack": "npm pack --dry-run",
        "audit": "node scripts/run-audit.mjs"
    },
    "devDependencies": {
        "@eliware/test": "^2.2.0",
        "@types/node": "^26.4.0",
        "ajv": "8.20.0",
        "ajv-formats": "3.0.1",
        "typescript": "^7.0.2"
    },
    "publishConfig": {
        "access": "public"
    }
}
